# Dependencies
node_modules/
.npm-cache/
# Build output
dist/

# Local data & auth
store/
logs/

# data/ is mostly local state, but track personal session customizations
# (per-group .claude/agents/ and .claude/skills/)
data/*
!data/sessions/
data/sessions/*
!data/sessions/*/
data/sessions/*/*
!data/sessions/*/.claude/
data/sessions/*/.claude/*
!data/sessions/*/.claude/agents/
!data/sessions/*/.claude/skills/
# Skills auto-synced from container/skills/ — don't double-track
data/sessions/*/.claude/skills/agent-browser/
data/sessions/*/.claude/skills/capabilities/
data/sessions/*/.claude/skills/slack-formatting/
data/sessions/*/.claude/skills/status/

# Groups - only track base structure and specific CLAUDE.md files
groups/*
!groups/main/
!groups/global/
groups/main/*
groups/global/*
!groups/main/CLAUDE.md
!groups/global/CLAUDE.md

# Secrets
*.keys.json
.env

# Temp files
.tmp-*

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Skills system (local per-installation state)
.nanoclaw/

# Python bytecode (mcp-servers/)
__pycache__/
*.py[cod]

# Personal advocacy/meeting notes accompanying docs/architecture-tradeoffs.md
tradeoffs-advocacy.md

agents-sdk-docs
